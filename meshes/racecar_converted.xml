<mujoco model="mushr_tx2">
  <compiler angle="radian"/>
  <option integrator="implicitfast"/>

  <asset>
    <mesh name="mushr_base_collision_tx2" file="mushr_base_collision_tx2.stl"/>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.9" rgb2="0.9 0.9 0.95" width="256" height="256"/>
    <texture name="groundplane" type="2d" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.6 0.6 0.6" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <!-- Joint defaults adapted from MuSHR buddy.xml (armature keeps the light steering parts numerically stable) -->
  <default>
    <default class="steering">
      <joint type="hinge" axis="0 0 1" limited="true" frictionloss="0.01" damping="0.001" armature="0.0002" range="-0.6 0.6"/>
    </default>
    <default class="throttle">
      <!-- damping/armature lowered 2026-10-27 (were 0.01/0.01: acted like ~32 N drag at 2 m/s and ~16 kg extra mass) -->
      <joint type="hinge" axis="0 1 0" frictionloss="0.001" damping="0.0005" armature="0.0005" limited="false"/>
    </default>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="70 110 0.1" material="groundplane"/>

    <body name="base_footprint">
      <inertial pos="0.0034485 0 0.103085" quat="0 0.671192 0 0.741284" mass="3.602" diaginertia="0.0474358 0.0444616 0.0250719"/>
      <joint name="world_to_base_footprint" type="free"/>
      <geom pos="0 0 0.094655" type="mesh" mesh="mushr_base_collision_tx2"/>
      <geom size="0.0005 0.0005 0.0005" pos="0.10075 0 0.259655" type="box" rgba="0 0 0 1"/>
      <geom size="0.005 0.005 0.005" pos="0.03975 0 0.274655" type="box" rgba="0 0 0 1"/>

      <!-- Virtual steering joint = bicycle-model steering angle (delta). No geom, does not collide. -->
      <body name="steering_virtual" pos="0.1385 0 0.0488">
        <inertial pos="0 0 0" mass="0.01" diaginertia="1e-05 1e-05 1e-05"/>
        <joint class="steering" name="steering" range="-0.49 0.49"/>
      </body>

      <!-- Each wheel is a direct child of the chassis, so wheel-chassis collisions are skipped automatically. -->
      <body name="front_left/wheel_link" pos="0.1385 0.115 0.0488">
        <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="0.1" diaginertia="0.000125 7e-05 7e-05"/>
        <joint class="steering" name="front_left_wheel_steer"/>
        <joint class="throttle" name="front_left_wheel_throttle"/>
        <geom size="0.05 0.0215" quat="0.707107 0.707107 0 0" type="cylinder"/>
      </body>
      <body name="front_right/wheel_link" pos="0.1385 -0.115 0.0488">
        <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="0.1" diaginertia="0.000125 7e-05 7e-05"/>
        <joint class="steering" name="front_right_wheel_steer"/>
        <joint class="throttle" name="front_right_wheel_throttle"/>
        <geom size="0.05 0.0215" quat="0.707107 0.707107 0 0" type="cylinder"/>
      </body>
      <body name="back_left/wheel_link" pos="-0.158 0.115 0.0488">
        <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="0.1" diaginertia="0.000125 7e-05 7e-05"/>
        <joint class="throttle" name="back_left_wheel_throttle"/>
        <geom size="0.05 0.0215" quat="0.707107 0.707107 0 0" type="cylinder"/>
      </body>
      <body name="back_right/wheel_link" pos="-0.158 -0.115 0.0488">
        <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="0.1" diaginertia="0.000125 7e-05 7e-05"/>
        <joint class="throttle" name="back_right_wheel_throttle"/>
        <geom size="0.05 0.0215" quat="0.707107 0.707107 0 0" type="cylinder"/>
      </body>
    </body>
  </worldbody>

  <!-- 4WD open differential: tendon velocity = average wheel speed (rad/s) -->
  <tendon>
    <fixed name="throttle">
      <joint joint="front_left_wheel_throttle" coef="0.25"/>
      <joint joint="front_right_wheel_throttle" coef="0.25"/>
      <joint joint="back_left_wheel_throttle" coef="0.25"/>
      <joint joint="back_right_wheel_throttle" coef="0.25"/>
    </fixed>
  </tendon>

  <!-- Ackermann: wheel angle = c0 + c1*d + c2*d^2 + c3*d^3 + c4*d^4, fit to L=0.2965 m, W=0.23 m (max error 0.0005 rad) -->
  <equality>
    <joint joint1="front_left_wheel_steer" joint2="steering" polycoef="0 1.00183 0.389851 0.115542 -0.0968192"/>
    <joint joint1="front_right_wheel_steer" joint2="steering" polycoef="0 1.00183 -0.389851 0.115542 0.0968192"/>
  </equality>

  <actuator>
    <!-- ctrl[0]: steering angle delta (rad) -->
    <position name="steering_pos" joint="steering" kp="25" ctrlrange="-0.49 0.49" ctrllimited="true"/>
    <!-- ctrl[1]: forward speed (m/s); gear = wheel radius 0.05 m converts rad/s to m/s. Speed clamp removed 2026-10-27 (was ctrlrange -5 5) -->
    <velocity name="throttle_velocity" tendon="throttle" gear="0.05" kv="50" ctrllimited="false" forcerange="-40 40" forcelimited="true"/>
  </actuator>
</mujoco>
